# Maintainer: eotter-beep <eotter-beep@users.noreply.github.com>
pkgname=lynx-de
pkgver=0.1.0
pkgrel=1
pkgdesc='A memory-safe, pure-Python desktop environment with its own compositor (LWP)'
arch=('x86_64')
url='https://github.com/eotter-beep/lynxDE'
license=('MIT')
depends=('python' 'python-pyside6' 'layer-shell-qt')
optdepends=(
    'xorg-xwayland: X11 app support via LWP bridge'
    'xdg-desktop-portal-hyprland: screen sharing and file dialogs'
    'qt6-wayland: native Qt theming on Wayland'
)
makedepends=('git')
options=(!strip !debug)
install=lynx-de.install
source=("$pkgname::git+https://github.com/eotter-beep/lynxDE.git")
sha256sums=('SKIP')

package() {
    cd "$pkgname"

    # Install source files to /usr/share/lynxde
    install -dm755 "$pkgdir/usr/share/lynxde"
    cp -a taskbar "$pkgdir/usr/share/lynxde/"
    cp -a sounds "$pkgdir/usr/share/lynxde/"
    cp -a docs "$pkgdir/usr/share/lynxde/"
    install -m755 install.sh "$pkgdir/usr/share/lynxde/"
    [ -f cromaconceptovisual-heart-5106075_1920.png ] && \
        install -m644 cromaconceptovisual-heart-5106075_1920.png "$pkgdir/usr/share/lynxde/"

    # Install launcher scripts to /usr/bin
    install -dm755 "$pkgdir/usr/bin"

    for comp in lynx-compositor lynx-taskbar lynx-titles lynx-settings \
        lynx-wallpaper lynx-launcher lynx-welcome lynx-autostart lynx-store \
        lynx-update; do
        cat > "$pkgdir/usr/bin/$comp" <<WRAPPER
#!/usr/bin/env bash
exec python3 /usr/share/lynxde/taskbar/${comp//-/_}.py "\$@"
WRAPPER
        chmod 755 "$pkgdir/usr/bin/$comp"
    done

    # Install desktop entry for Lynx Store
    install -dm755 "$pkgdir/usr/share/applications"
    cat > "$pkgdir/usr/share/applications/lynx-store.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Lynx Store
GenericName=Package Manager
Comment=Browse, install and remove pacman packages
Exec=/usr/bin/lynx-store
Icon=system-software-install
Terminal=false
Categories=System;PackageManager;
Keywords=store;package;pacman;install;remove;software;
StartupWMClass=lynx-store
EOF

    # Install session files
    install -dm755 "$pkgdir/usr/share/wayland-sessions"

    cat > "$pkgdir/usr/share/wayland-sessions/lynxde.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Lynxde
Comment=Native Lynx Window Protocol (LWP) desktop
Exec=/usr/bin/lynxde-session-lwp
DesktopNames=Lynxde
Terminal=false
EOF

    cat > "$pkgdir/usr/share/wayland-sessions/lynxde-wayland.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Lynxde (LWP + Wayland)
Comment=Legacy Hyprland stack over LWP Wayland support, no X11 apps
Exec=/usr/bin/lynxde-session-wayland
DesktopNames=Lynxde
Terminal=false
EOF

    cat > "$pkgdir/usr/share/wayland-sessions/lynxde-x11.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Lynxde (LWP + Wayland + X11)
Comment=Legacy Hyprland stack with XWayland for X11 apps
Exec=/usr/bin/lynxde-session-x11
DesktopNames=Lynxde
Terminal=false
EOF

    # Install session launcher scripts
    cat > "$pkgdir/usr/bin/lynxde-session-lwp" <<'EOF'
#!/usr/bin/env bash
# Lynxde session: native LWP compositor + desktop.
set -euo pipefail
export LYNXDE_LWP=1
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export PATH="/usr/bin:$PATH"

children=()
cleanup() {
  trap - EXIT INT TERM
  for pid in "${children[@]:-}"; do
    [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
  done
}
trap cleanup EXIT INT TERM

/usr/bin/lynx-compositor --backend "${LYNX_BACKEND:-auto}" \
  --with-wayland-bridge >>"${XDG_CACHE_HOME:-$HOME/.cache}/lynxde/taskbar.log" 2>&1 &
COMPID=$!
children+=("$COMPID")

SOCK="$XDG_RUNTIME_DIR/lynx/lwp.sock"
for _ in $(seq 1 100); do [ -S "$SOCK" ] && break; sleep 0.1; done
if [ ! -S "$SOCK" ]; then
  echo "lynxde: compositor failed to open $SOCK" >&2
  exit 1
fi

run() { "$@" >>"${XDG_CACHE_HOME:-$HOME/.cache}/lynxde/taskbar.log" 2>&1 & children+=("$!"); }
run /usr/bin/lynx-taskbar
run /usr/bin/lynx-launcher --autostart
run /usr/bin/lynx-welcome
run /usr/bin/lynx-autostart
( sleep 180; /usr/bin/lynx-update >>"${XDG_CACHE_HOME:-$HOME/.cache}/lynxde/taskbar.log" 2>&1 ) & children+=("$!")

wait "$COMPID"
EOF
    chmod 755 "$pkgdir/usr/bin/lynxde-session-lwp"

    cat > "$pkgdir/usr/bin/lynxde-session-wayland" <<'EOF'
#!/usr/bin/env bash
# Lynxde legacy session: Hyprland over LWP Wayland support (no X11).
set -euo pipefail
export LYNXDE_WAYLAND_ONLY=1
exec Hyprland "$@"
EOF
    chmod 755 "$pkgdir/usr/bin/lynxde-session-wayland"

    cat > "$pkgdir/usr/bin/lynxde-session-x11" <<'EOF'
#!/usr/bin/env bash
# Lynxde legacy session: Hyprland with XWayland for X11 apps.
set -euo pipefail
unset LYNXDE_WAYLAND_ONLY
exec Hyprland "$@"
EOF
    chmod 755 "$pkgdir/usr/bin/lynxde-session-x11"

    # Install license
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
